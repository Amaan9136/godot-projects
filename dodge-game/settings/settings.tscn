[gd_scene format=3]

[ext_resource type="Script" path="res://settings/settings.gd" id="1_settings"]
[ext_resource type="Texture2D" path="res://assets/icons/music.svg" id="2_music"]
[ext_resource type="Texture2D" path="res://assets/icons/volume-2.svg" id="3_volume"]
[ext_resource type="Script" path="res://settings/theme_carousel.gd" id="4_carousel"]

[node name="SettingsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 40.0
offset_right = -40.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 24
alignment = 1

[node name="TitleLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "SETTINGS"
horizontal_alignment = 1
theme_type_variation = &"ScreenTitle"

[node name="MusicRow" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
